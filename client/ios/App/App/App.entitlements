<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications. Xcode sets production automatically for TestFlight / App Store builds. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Links to the site (https://<host>/c/..., /m/...) open the app. Replace with the real site host. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:club.example.co.il</string>
	</array>
</dict>
</plist>
