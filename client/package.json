{
  "name": "fami-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:demo": "vite build --mode demo",
    "build:app": "vite build --mode app",
    "build:app-demo": "vite build --mode demo --outDir dist --emptyOutDir",
    "app:sync": "npm run build:app && cap sync",
    "app:assets": "capacitor-assets generate --ios --android --assetPath resources --iconBackgroundColor \"#FFFBED\" --splashBackgroundColor \"#FFFBED\"",
    "android:open": "cap open android",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5"
  }
}
