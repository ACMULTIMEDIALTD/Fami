# --- core ---
PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fami
# Render external connections need SSL; internal URL does not
DATABASE_SSL=false
JWT_SECRET=change-me-to-a-long-random-string

# Public URL of the React app (used in magic links, WhatsApp text, redirects)
APP_URL=http://localhost:5173
# Comma-separated origins allowed to call the API with credentials.
# Not needed when the client proxies /api through Vercel rewrites (recommended).
CORS_ORIGIN=http://localhost:5173
# Cookie flags. Defaults: Secure in production, SameSite=Lax.
# If the API is called cross-site (no Vercel proxy) set COOKIE_SAMESITE=none.
COOKIE_SAMESITE=lax

# --- community ---
CURRENT_TERMS_VERSION=2026-10-v1
TERMS_PDF_URL=https://example.com/terms-2026-10-v1.pdf
WHATSAPP_GROUP_URL=https://chat.whatsapp.com/XXXXXXXX

# --- seed admin ---
ADMIN_EMAIL=noa@example.com
ADMIN_PASSWORD=change-me

# --- email (optional; without SMTP_URL emails are printed to the log) ---
SMTP_URL=
MAIL_FROM="נועה אביטל <no-reply@example.com>"
# Where brand inquiries / new-signup notices go (defaults to ADMIN_EMAIL)
NOTIFY_EMAIL=

# --- push notifications to the app (optional) ---
# Android: Firebase Cloud Messaging.
# Firebase console → Project settings → Service accounts → Generate new private key,
# then paste the JSON here on ONE line. Without it, pushes are only logged.
FIREBASE_SERVICE_ACCOUNT=
# Apple push for the iPhone app: developer.apple.com → Certificates, IDs & Profiles → Keys → "+" with APNs.
# Paste the .p8 file contents with \n for line breaks.
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=il.co.noaavital.creatorclub
# false while testing a debug build from Xcode (sandbox); true for TestFlight / App Store
APNS_PRODUCTION=true
